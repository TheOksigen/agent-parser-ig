DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=instagram_parser"
ADMIN_PASSWORD="replace-with-a-long-random-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
COOKIE_SECURE="false"
TASK_LEASE_SECONDS="180"
# Toplama intervalı Tapşırıqlar panelindən təyin edilir (standart: 10 saniyə).
MAX_PROFILE_SCROLLS="200"
MAX_POSTS_PER_TASK="500"
SCHEDULER_INTERVAL_SECONDS="60"
